# ---- LLM provider -----------------------------------------------------------
# openai | anthropic
NAMI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
# gpt-4.1 (fast, structured outputs) | gpt-4.1-mini | gpt-5 | gpt-5-mini
NAMI_MODEL=gpt-4.1

# Anthropic (only if NAMI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# NAMI_MODEL=claude-opus-5-5

# ---- Tuning -----------------------------------------------------------------
# low | medium | high  (gpt-5/o-series reasoning effort; Claude effort; ignored by gpt-4.x)
NAMI_EFFORT=low
NAMI_PORT=8765        # nami.server (실증용)
NAMI_EXP_PORT=8766    # exp.server (실험용)
# NAMI_MOCK=1   # offline canned replies, no API calls
